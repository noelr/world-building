# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id available on OpenRouter, e.g. anthropic/claude-haiku-4.5,
# openai/gpt-4o-mini, meta-llama/llama-3.1-8b-instruct
# Browse current ids (and check they have active provider endpoints) at
# https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: shown to OpenRouter as the referring site.
OPENROUTER_SITE_URL=http://localhost:3000

# Voice narration is generated via an OpenRouter audio-output model (not the
# browser's local text-to-speech voices). Must be a model with audio output
# support - check https://openrouter.ai/models?fmt=table&output_modalities=audio
# OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-audio-preview
# One of OpenAI's preset voices: alloy, echo, fable, onyx, nova, shimmer
# OPENROUTER_TTS_VOICE=alloy

# Optional overrides
PORT=3000
DB_PATH=data.db
