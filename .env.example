# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id available on OpenRouter, e.g. anthropic/claude-haiku-4.5,
# openai/gpt-4o-mini, meta-llama/llama-3.1-8b-instruct
# Browse current ids (and check they have active provider endpoints) at
# https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: shown to OpenRouter as the referring site.
OPENROUTER_SITE_URL=http://localhost:3000

# Voice narration is generated via OpenRouter's dedicated text-to-speech
# endpoint (POST /api/v1/audio/speech), not the browser's local voices.
# Voices are namespaced per model/provider (an OpenAI voice name will not
# work on a Voxtral or Kokoro model) - model and voice must be changed
# together. List current models + their supported_voices at:
#   https://openrouter.ai/api/v1/models?output_modalities=speech
# OPENROUTER_TTS_MODEL=mistralai/voxtral-mini-tts-2603
# OPENROUTER_TTS_VOICE=en_paul_neutral

# Optional overrides
PORT=3000
DB_PATH=data.db
