# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id available on OpenRouter, e.g. anthropic/claude-3.5-haiku,
# openai/gpt-4o-mini, meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Optional: shown to OpenRouter as the referring site.
OPENROUTER_SITE_URL=http://localhost:3000

# Optional overrides
PORT=3000
DB_PATH=data.db
